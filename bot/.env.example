# Discord application bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_BOT_TOKEN=

# Base URL of the Laravel app (no trailing slash)
LARAVEL_BASE_URL=http://localhost:8000

# Must match BOT_SERVICE_TOKEN in the Laravel app's .env
BOT_SERVICE_TOKEN=local-dev-service-token-change-me

# How often to poll GET /internal/outbound-actions, in milliseconds
OUTBOUND_POLL_INTERVAL_MS=3000
